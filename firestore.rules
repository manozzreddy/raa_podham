rules_version = '2';

// All ride mutations (create/join/leave/end) go through the backend,
// which uses the Admin SDK and so is unaffected by these rules — they
// only govern the mobile app's direct, read-only Firestore access
// (features/home/data/membership_repository.dart) plus each user's own
// profile doc, written by the mobile app right after sign-in
// (features/auth/data/user_profile_repository.dart).
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own profile — read/write by that user only. The backend
    // reads this (via the Admin SDK, bypassing these rules) to populate
    // a ride member's displayName/photoUrl.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /rides/{rideId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /members/{uid} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/rides/$(rideId)).data.memberUids;
        allow write: if false;
      }
    }

    // Invite-code lookup is backend-only (JoinRide resolves the code to
    // a ride ID server-side) — no client ever needs to read this
    // directly.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }
  }
}
