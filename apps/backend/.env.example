# Local dev config, loaded automatically by internal/config.Load() via
# godotenv. Copy this file to .env (already gitignored) and adjust if
# needed — real environment variables (as Cloud Run provides in
# production) always take precedence over these.

# Address the server binds to. Blank (the default) means all
# interfaces — the same as Go's net/http treats an Addr with no host
# part — so the API is already reachable from other devices on your
# LAN at http://<this-machine's-LAN-IP>:8080 without setting this.
# Set to 127.0.0.1 to restrict the server to this machine only.
HOST=

FIREBASE_PROJECT_ID=raa-podham
RTDB_URL=https://raa-podham-default-rtdb.asia-southeast1.firebasedatabase.app

# Places API (New) key, proxied by internal/repository/google_places_repository.go
# so it never ships inside the mobile app. Restrict it in Google Cloud
# Console to just "Places API (New)" plus an IP allowlist for wherever
# this backend actually runs (Cloud Run's IPs aren't static by default —
# see Cloud Run docs for a static outbound IP if you want this locked
# down tighter than "any IP").
GOOGLE_PLACES_API_KEY=
