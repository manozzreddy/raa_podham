{
  "rules": {
    "rides": {
      "$rideId": {
        "positions": {
          ".read": "auth != null && root.child('rides').child($rideId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rides').child($rideId).child('members').child(auth.uid).child('present').val() === true)"
          }
        },
        "members": {
          ".read": "auth != null && root.child('rides').child($rideId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
